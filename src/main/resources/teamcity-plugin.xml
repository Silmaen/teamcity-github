<?xml version="1.0" encoding="UTF-8"?>
<teamcity-plugin xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                 xsi:noNamespaceSchemaLocation="urn:schemas-jetbrains-com:teamcity-plugin-v1-xml">
    <info>
        <name>teamcity-github-bridge</name>
        <display-name>TeamCity GitHub Bridge</display-name>
        <description>
            Improves the TeamCity to GitHub integration:
            detects PR draft state, retriggers builds on draft-to-ready
            transitions, and exposes richer commit statuses.
        </description>
        <version>1.3.0</version>
        <vendor>
            <name>Damien Lachouette</name>
            <url>https://github.com/silmaen/teamcity-github</url>
        </vendor>
        <email>genteur.slayer@laposte.net</email>
        <min-build>222521</min-build>
    </info>

    <deployment use-separate-classloader="true"/>

    <parameters>
        <parameter name="teamcity.github.bridge.api.base">https://api.github.com</parameter>
        <parameter name="teamcity.github.bridge.api.version">2022-11-28</parameter>
        <parameter name="teamcity.github.bridge.prinfo.cache.ttl.seconds">60</parameter>
        <parameter name="teamcity.github.bridge.webhook.path">/app/teamcity-github-bridge/webhook</parameter>
    </parameters>
</teamcity-plugin>
